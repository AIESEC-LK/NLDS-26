???# ==============================================================================
# NLDS 2026 ENVIRONMENT CONFIGURATION (EXAMPLE)
# ==============================================================================
# IMPORTANT:
# - NEVER COMMIT real secrets to version control.
# - Do NOT use NEXT_PUBLIC_ for sensitive backend metrics.
# - Duplicate this file to .env.local for local development testing.
# ==============================================================================

# -----------------
# 1. DATABASE
# -----------------
# YugabyteDB / PostgreSQL connection string
# MUST NOT have NEXT_PUBLIC_ prefix!
DATABASE_URL="postgresql://user:password@localhost:5433/nlds?schema=public"

# -----------------
# 2. APPLICATION URL
# -----------------
# The canonical public URL mapping for Next.js frontend bindings
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# -----------------
# 3. AUTHENTICATION / SESSIONS
# -----------------
# Cryptographically secure random UUID / Base64 string for hashing sessions globally
# DO NOT include NEXT_PUBLIC_ prefix
SESSION_SECRET="replace-with-a-very-long-secure-random-string"

# -----------------
# 4. TELEGRAM WH CONFIGURATION
# -----------------
# Bot Token & Output Chat configuration bounds. DO NOT expose to browser limits.
# Leave blank to silently skip execution triggers locally.
TELEGRAM_BOT_TOKEN="123456789:replace-with-telegram-bot-token"
TELEGRAM_CHAT_ID="-1000000000000"

# -----------------
# 5. GOOGLE SHEETS
# -----------------
# Extracted from the Google JSON Credentials format. Leave blank to skip pushes.
GOOGLE_CLIENT_EMAIL="example@example-service.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----"

# Admin App Webhook (Replaces heavy Google Sheets API logic)
ADMIN_SYNC_URL=
CRON_SECRET=

# -----------------
# 6. EMAIL / OTP
# -----------------
# Email provider secrets restricting OTP dispatches over pure backend configurations

# -----------------
# 7. CAPTCHA (CLOUDFLARE TURNSTILE)
# -----------------
# Cloudflare Turnstile Site Key for frontend rendering
NEXT_PUBLIC_TURNSTILE_SITE_KEY="1x00000000000000000000AA"
# Cloudflare Turnstile Secret Key for backend validation
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# DRIVE IN INTEGRATIONS
GOOGLE_DRIVE_CV_FOLDER_ID=\\
GOOGLE_DRIVE_PHOTO_FOLDER_ID=\
